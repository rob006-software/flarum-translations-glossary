<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="en">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Translate Toolkit</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Submit</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Enviar</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Delete</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Eliminar</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Email Address</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Correo electrónico</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>2FA</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>2FA</term></tig></langSet>
                <descrip>Two-factor authentication</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>URL</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>URL</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>OAuth</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>OAuth</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Composer</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Composer</term></tig></langSet>
                <descrip>Usually the editor panel for writing discussions and replies. Can also mean Composer, the PHP dependency manager (a product name).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>queue</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>cola</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Private discussion</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Discusión privada</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Tier</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Nivel</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Change</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Cambiar</term></tig></langSet>
                <descrip>To modify something (verb), or a modification (noun).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Definition</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Definición</term></tig></langSet>
                <descrip>A statement that explains the meaning of a word or phrase, or expressing the essential nature of something.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Badge</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Insignia</term></tig></langSet>
                <descrip>The thing used to identify oneself in a way or represent membership in a society or group.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Avatar</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Avatar</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Username</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Nombre de usuario</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Accept</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>Aceptar</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>user</term></tig></langSet>
                <langSet xml:lang="es"><tig><term>usuario</term></tig></langSet>
