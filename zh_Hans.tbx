            <termEntry>
                <langSet xml:lang="en"><tig><term>Change</term></tig></langSet>
                <langSet xml:lang="zh_Hans"><tig><term>修改</term></tig></langSet>
                <note from="translator">修改、改变、更改、变更等含义</note>
                <descrip>To modify something (verb), or a modification (noun).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Term</term></tig></langSet>
                <langSet xml:lang="zh_Hans"><tig><term>术语</term></tig></langSet>
