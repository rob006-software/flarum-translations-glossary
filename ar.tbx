                <langSet xml:lang="ar"><tig><term>حذف</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Email Address</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>البريد الإلكتروني</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>spoiler</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>حرق الأحداث</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>extension</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>إضافة</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>extensions</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الإضافات</term></tig></langSet>
            </termEntry>
            <termEntry id="1">
                <langSet xml:lang="en"><tig><term>extensions</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الإضافات</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>package</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الحزمة</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>URL</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>عنوان الرابط</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>packages</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الحزم</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Composer</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>برنامج إدارة التبعيات</term></tig></langSet>
                <descrip>PHP dependency manager.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>repositories</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>المستودعات</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>queue</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>قائمة الانتظار</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Money</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>أموال</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Firebase</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>منصة فايربايس</term></tig></langSet>
                <descrip>Google's app development platform.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Refresh</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>تحديث</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Best Answer</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>أفضل إجابة مقترحة</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Private discussion</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>محادثة خاصة</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bio</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>السيرة الذاتية</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>slug</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>سّلاَج</term></tig></langSet>
                <note from="translator">السّلاَج (Slug) هو جزء من عنوان URL يستخدم لتعريف صفحة أو مقال بشكل فريد، وعادةً ما يكون نصًا مختصرًا وواضحًا يُكتب باللغة الإنجليزية أو أي لغة أخرى بدون مسافات. يتم تحويل النص إلى أحرف صغيرة ويتم استبدال المسافات بشرطات (-).</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Tier</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الطبقة</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Original Poster</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الناشر الأصلي</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Bounty</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>مكافأة</term></tig></langSet>
                <descrip>A reward (e.g. money or points) offered on a discussion, usually for answering or solving it.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Twitch</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>منصة تويتش</term></tig></langSet>
                <descrip>Twitch is a video game live-streaming service.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>GeeTest CAPTCHA</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>إختبار كابتشا بالذكاء الإصطناعي</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Approval</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الموافقة.</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Change</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>تغيير</term></tig></langSet>
                <descrip>To modify something (verb), or a modification (noun).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Auto Moderator</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>إدارة آلية</term></tig></langSet>
                <descrip>Name of an extension that automatically performs moderation actions (like adding users to groups) based on configured rules.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Term</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>مصطلح</term></tig></langSet>
                <descrip>A word or phrase that is used to refer to a particular thing.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Glossary</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>قائمة المصطلحات</term></tig></langSet>
                <descrip>A glossary is an alphabetical list of terms in a particular domain of knowledge with the definitions for those terms.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Definition</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>تعريف</term></tig></langSet>
                <descrip>A statement that explains the meaning of a word or phrase, or expressing the essential nature of something.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Best Answers</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>أفضل إجابة</term></tig></langSet>
                <descrip>The reply marked as the best answer to the question asked in a discussion.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Two Factor</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>مصادقة ثنائية</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Two-Factor</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>مصادقة-ثنائية</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Badge</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>شارة</term></tig></langSet>
                <descrip>The thing used to identify oneself in a way or represent membership in a society or group.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Parameter</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>الإعدادات</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Masquerade</term></tig></langSet>
                <langSet xml:lang="ar"><tig><term>إنشاء تبويب مخصص للملف الشخصي على صفحة المستخدم</term></tig></langSet>
                <descrip>Name of the FriendsOfFlarum extension that adds custom profile fields (the "masquerade profile") to users.</descrip>
            </termEntry>
        </body>
    </text>
</martif>
