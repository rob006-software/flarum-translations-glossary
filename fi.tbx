                <langSet xml:lang="fi"><tig><term>paketti</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>URL</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>URL</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>OAuth</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>OAuth</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>packages</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>paketit</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Composer</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Muokkain</term></tig></langSet>
                <descrip>Usually the editor panel for writing discussions and replies. Can also mean Composer, the PHP dependency manager (a product name).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>repositories</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>varastot</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>queue</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>jono</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Money</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Raha</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Firebase</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Firebase</term></tig></langSet>
                <descrip>Google's app development platform.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Refresh</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Päivitä</term></tig></langSet>
