            <termEntry>
                <langSet xml:lang="en"><tig><term>Best Answer</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Paras vastaus</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Private discussion</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Yksityinen keskustelu</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>ASN</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>ASN</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>ISP</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Internet palveluntarjoaja</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bio</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>kuvaus</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>slug</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>tunniste</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Clockwork</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Clockwork</term></tig></langSet>
                <descrip>Name of a PHP development tool for profiling and debugging requests.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Tier</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Taso</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Original Poster</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Alkuperäinen kirjoittaja</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>OP</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>OP</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Bounty</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Palkkio</term></tig></langSet>
                <descrip>A reward (e.g. money or points) offered on a discussion, usually for answering or solving it.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Twitch</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Twitch</term></tig></langSet>
                <note from="translator">Twitch on pelien live striimaus palvelu.</note>
                <descrip>Twitch is a video game live-streaming service.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Approval</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Hyväksyntä</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Change</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Vaihda</term></tig></langSet>
                <descrip>To modify something (verb), or a modification (noun).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Auto Moderator</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Auto moderaattori</term></tig></langSet>
                <note from="translator">Auto Moderaattori, lisäosa joka käyttää tiettyjä sääntöjä tehdäkseen päätöksiä sisällöstä.</note>
                <descrip>Name of an extension that automatically performs moderation actions (like adding users to groups) based on configured rules.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Term</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Avainsana</term></tig></langSet>
                <descrip>A word or phrase that is used to refer to a particular thing.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Glossary</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Sanasto</term></tig></langSet>
                <note from="translator">Sanasto on aakkostettu lista termeistä ja niiden määritelmistä.</note>
                <descrip>A glossary is an alphabetical list of terms in a particular domain of knowledge with the definitions for those terms.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Definition</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Määritelmä</term></tig></langSet>
                <descrip>A statement that explains the meaning of a word or phrase, or expressing the essential nature of something.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Best Answers</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Paras vastaus</term></tig></langSet>
                <note from="translator">Paras vastaus joka liittyy keskusteluun tai kysymykseen</note>
                <descrip>The reply marked as the best answer to the question asked in a discussion.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Two Factor</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Kaksivaiheinen</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Two-Factor</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Kaksivaiheinen</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Badge</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Merkki</term></tig></langSet>
                <descrip>The thing used to identify oneself in a way or represent membership in a society or group.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Parameter</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Parametri</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Endpoint</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Päätepiste (endpoint)</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Masquerade</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Masquerade</term></tig></langSet>
                <note from="translator">FriendsOfFlarum's Masquerade lisäosa lisää profiili välilehden käyttäjän sivulle.</note>
                <descrip>Name of the FriendsOfFlarum extension that adds custom profile fields (the "masquerade profile") to users.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>dashboard</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>hallintapaneeli</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Header</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Yläosa</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>CAPTCHA</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>CAPTCHA</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Style</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Tyyli</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Custom Header</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Mukautettu yläosa</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Custom Footer</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Mukautettu alaosa</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Dark Mode</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>Tumma tila</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>CSS</term></tig></langSet>
                <langSet xml:lang="fi"><tig><term>CSS</term></tig></langSet>
            </termEntry>
            <termEntry>
