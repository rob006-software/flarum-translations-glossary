            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>driver</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>sürücü</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>password</term></tig></langSet>
