            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>CSS</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>CSS</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>user</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>kullanıcı</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>default</term></tig></langSet>
