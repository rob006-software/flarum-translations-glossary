                <langSet xml:lang="tr"><tig><term>Jeton</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>limit</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>sınır</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>extension</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>uzantı</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>extensions</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>uzantılar</term></tig></langSet>
                <note from="translator">Cümle içerisinde geçtiği durumu kontrol edin. İngilizcedeki çoğul kullanım örnekleri ile Türkçe'deki çoğul kullanım örnekleri farklıdır. Örn: "Uninstall 2 extensions" kalıbı "2 uzantıları kaldır" şeklinde çevrilemez. Doğrusu "2 uzantıyı kaldır" şeklinde bir çeviri olması gerekir.</note>
            </termEntry>
            <termEntry id="1">
                <langSet xml:lang="en"><tig><term>extensions</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>uzantılar</term></tig></langSet>
