            <termEntry>
                <langSet xml:lang="en"><tig><term>Modal</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Pencere</term></tig></langSet>
                <note from="translator">Açılan pencereler için kullanılır</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Original</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Aslı</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Position</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Konum</term></tig></langSet>
                <note from="translator">Pozisyon olarak karşılı olsa da genelde "konum" anlamında kullanılır.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>2FA</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>İki Adımlı Doğrulama</term></tig></langSet>
                <note from="translator">"2 Factor Authentication" ifadesinin kısaltılmış halidir. İngilizce dilinde yaygın olarak kullanılsa da Türkçe için yaygın bir kullanımı olmadığından dolayı ifadeyi kısaltma olmadan çevirmeniz önerilir.</note>
                <descrip>Two-factor authentication</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Optional</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Tercihe Bağlı</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>button</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>düğme</term></tig></langSet>
                <note from="translator">Türkçe'mizde "button" kelimesi "buton" olarak değil "düğme" olarak çevrilir.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>URL</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>bağlantı</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>link</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>bağlantı</term></tig></langSet>
            </termEntry>
            <termEntry>
