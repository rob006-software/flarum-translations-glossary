                <langSet xml:lang="tr"><tig><term>ad alanı</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Submit</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Gönder</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Delete</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Sil</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Email Address</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>E-Posta Adresi</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Reply</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Yanıt</term></tig></langSet>
                <note from="translator">Cevap kelimesi Arapçadır. Mümkün olduğunca Öz Türkçe kullanımına özen göstermek için Reply kelimesini Yanıt olarak çevirelim.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Feed</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Akış</term></tig></langSet>
                <note from="translator">Feed için besleme değil Akış ifadesi kullanılmalıdır</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Image</term></tig></langSet>
                <langSet xml:lang="tr"><tig><term>Görsel</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Article</term></tig></langSet>
