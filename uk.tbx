        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Submit</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Надіслати</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Delete</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Знащити</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>2FA</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>2FA</term></tig></langSet>
                <note from="translator">двофакторна авторизація</note>
                <descrip>Two-factor authentication</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>spoiler</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>спойлер</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>extension</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>розширення</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>extensions</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>розширення</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>package</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>пакунок</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>URL</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>URL-адреса</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>OAuth</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>OAuth</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>packages</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>пакунки</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Composer</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Composer</term></tig></langSet>
                <descrip>Usually the editor panel for writing discussions and replies. Can also mean Composer, the PHP dependency manager (a product name).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>repositories</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>репозиторії</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>queue</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>черга</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Money</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Гроші</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Firebase</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Firebase</term></tig></langSet>
                <descrip>Google's app development platform.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Refresh</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Оновити</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Best Answer</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Найкраща відповідь</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Private discussion</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Приватна дискусія</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>ASN</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>ASN</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>ISP</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>ISP</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>bio</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>біографія</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>slug</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>псевдонім</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Clockwork</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Clockwork</term></tig></langSet>
                <descrip>Name of a PHP development tool for profiling and debugging requests.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Tier</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Рівень</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Original Poster</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Оригінальний постер</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>OP</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>OP</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Apple</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Apple</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Bounty</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Подарунок</term></tig></langSet>
                <descrip>A reward (e.g. money or points) offered on a discussion, usually for answering or solving it.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Twitch</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Twitch</term></tig></langSet>
                <descrip>Twitch is a video game live-streaming service.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Approval</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Схвалення</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Change</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Зміна</term></tig></langSet>
                <descrip>To modify something (verb), or a modification (noun).</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Auto Moderator</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Автоматичний модератор</term></tig></langSet>
                <descrip>Name of an extension that automatically performs moderation actions (like adding users to groups) based on configured rules.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Term</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Термін</term></tig></langSet>
                <descrip>A word or phrase that is used to refer to a particular thing.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Glossary</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Словник</term></tig></langSet>
                <descrip>A glossary is an alphabetical list of terms in a particular domain of knowledge with the definitions for those terms.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Definition</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Визначення</term></tig></langSet>
                <descrip>A statement that explains the meaning of a word or phrase, or expressing the essential nature of something.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Best Answers</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Найкращі відповіді</term></tig></langSet>
                <descrip>The reply marked as the best answer to the question asked in a discussion.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Two Factor</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Двофакторний</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Two-Factor</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Двофакторний</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Badge</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Бейдж</term></tig></langSet>
                <descrip>The thing used to identify oneself in a way or represent membership in a society or group.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Parameter</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Параметр</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Endpoint</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Кінцева точка</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Masquerade</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Маскарад</term></tig></langSet>
                <descrip>Name of the FriendsOfFlarum extension that adds custom profile fields (the "masquerade profile") to users.</descrip>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>dashboard</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>панель</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Header</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Шапка</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>CAPTCHA</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>CAPTCHA</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Style</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Стиль</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Custom Header</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Користувацька шапка</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Custom Footer</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Користувацький підвал</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Dark Mode</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Темний режим</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>CSS</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>CSS</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>user</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>користувач</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>default</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>за налаштуванням</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>driver</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>драйвер</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>password</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>пароль</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>tag</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>тег</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>banner</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>банер</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Domain</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>Домен</term></tig></langSet>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>tokens</term></tig></langSet>
                <langSet xml:lang="uk"><tig><term>токени</term></tig></langSet>
                <descrip>Usually a security token used for authentication or access (e.g. access token, API token). In AI-related settings, also a unit of text processed by a model.</descrip>
            </termEntry>
        </body>
    </text>
</martif>
